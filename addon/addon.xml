<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="audio.music-server" name="Music Server Streams" version="1.0.0" provider-name="Music Server">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>audio</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">YouTube genre streams for Kodi</summary>
        <description lang="en">Plays smooth jazz, cocktail piano, and top 40 hits from YouTube streams.</description>
        <platform>all</platform>
        <license>MIT</license>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>